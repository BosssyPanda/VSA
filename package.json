{
  "name": "month-end",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "qa": "npm run typecheck && npm run lint && npm run qa:palette && npm run qa:type-floor && npm run qa:glyphs && npm run qa:literals && npm run qa:messages && npm run qa:engine && npm run qa:golden",
    "qa:a11y": "node scripts/qa/a11y.mjs",
    "qa:browser": "npm run build && npm run qa:smoke && npm run qa:responsive && npm run qa:i18n && npm run qa:a11y",
    "qa:build-engine": "node scripts/qa/build-engine.mjs",
    "qa:engine": "node scripts/qa/engine-props.mjs",
    "qa:golden": "node scripts/qa/golden-draws.mjs",
    "qa:i18n": "node scripts/qa/i18n-expand.mjs",
    "qa:literals": "node scripts/qa/no-literals.mjs",
    "qa:messages": "node scripts/qa/messages-audit.mjs",
    "qa:messages:write": "node scripts/qa/messages-audit.mjs --write",
    "qa:palette": "node scripts/qa/palette-audit.mjs",
    "qa:responsive": "node scripts/qa/responsive.mjs",
    "qa:shot": "node scripts/qa/shot.mjs",
    "qa:smoke": "node scripts/qa/smoke.mjs",
    "qa:type-floor": "node scripts/qa/type-floor.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "qa:glyphs": "node scripts/qa/glyphs.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "next": "^15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
